# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Lưu ý: Không lưu mật khẩu hoặc secrets thật vào file này!
# Sao chép file này thành .env và điền giá trị bảo mật cho môi trường của bạn.
# ==========================================

# Môi trường chạy (development | staging | production)
ENVIRONMENT=development
DEBUG=true

# Cấu hình Cơ sở dữ liệu PostgreSQL (Giá trị minh họa)
# Mặc định khi chạy backend trực tiếp trên Windows (Host: 127.0.0.1, Port: 5434)
# Khi chạy trong Docker Compose, biến này sẽ được ghi đè: POSTGRES_HOST=db, POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_app
POSTGRES_PASSWORD=your_secure_password_here

# Cấu hình pgAdmin (Giá trị minh họa)
PGADMIN_DEFAULT_EMAIL=admin@expensetracker.local
PGADMIN_DEFAULT_PASSWORD=example_pgadmin_password_replace_in_env

# Cấu hình Backend FastAPI & Auth Session
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SESSION_COOKIE_NAME=session_token
SESSION_EXPIRE_DAYS=7
SESSION_COOKIE_SECURE=false
FAMILY_INVITATION_EXPIRE_DAYS=7
RETURN_INVITATION_TOKEN_IN_DEV=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Cấu hình Frontend React (Vite)
VITE_API_BASE_URL=http://localhost/api/v1

# Cấu hình Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Cấu hình Giám sát (Monitoring Ports & Credentials)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=example_grafana_password_replace_in_env
LOKI_PORT=3100
ALLOY_PORT=12345
